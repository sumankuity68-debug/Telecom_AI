# ============================================================
# TelecomAI Production Environment Configuration Example
# Copy this file to .env and populate with your production credentials.
# NEVER commit actual secrets to version control.
# ============================================================

# Application Environment (production / development / test)
APP_ENV=production

# Database Configuration (PostgreSQL for production; SQLite fallback in dev)
DATABASE_URL=postgresql://telecom_user:secure_password_here@localhost:5432/telecom_ai

# Security & JWT Authentication
JWT_SECRET_KEY=replace_with_a_cryptographically_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_DEMO_PASSWORD=false

# Networking & CORS
FASTAPI_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/minute
OTP_RATE_LIMIT=5/minute
STATE_CHANGE_RATE_LIMIT=10/minute
DEFAULT_RATE_LIMIT=60/minute

# External Services (Groq Cloud LLM & Whisper STT)
GROQ_API_KEY=your_groq_api_key_here

# Telephony Services (Twilio SMS OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here

# Cell Tower Telemetry Service
OPENCELLID_API_KEY=your_opencellid_api_key_here
